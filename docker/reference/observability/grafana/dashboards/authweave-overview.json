            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "targets": [
                {
                    "expr": "sum by (authweave_outcome) (rate(authweave_authentication_attempts_total{service_namespace=~\"$service_namespace\",service_name=~\"$service_name\",deployment_environment_name=~\"$deployment_environment\",authweave_profile=~\"$authweave_profile\"}[5m]))",
                    "legendFormat": "{{authweave_outcome}}",
                    "refId": "A"
                }
            ],
            "title": "Authentication rate by outcome",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "authweave-prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "id": 2,
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum by (le) (rate(authweave_authentication_duration_seconds_bucket{service_namespace=~\"$service_namespace\",service_name=~\"$service_name\",deployment_environment_name=~\"$deployment_environment\",authweave_profile=~\"$authweave_profile\"}[5m])))",
                    "legendFormat": "p50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(authweave_authentication_duration_seconds_bucket{service_namespace=~\"$service_namespace\",service_name=~\"$service_name\",deployment_environment_name=~\"$deployment_environment\",authweave_profile=~\"$authweave_profile\"}[5m])))",
                    "legendFormat": "p95",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, sum by (le) (rate(authweave_authentication_duration_seconds_bucket{service_namespace=~\"$service_namespace\",service_name=~\"$service_name\",deployment_environment_name=~\"$deployment_environment\",authweave_profile=~\"$authweave_profile\"}[5m])))",
                    "legendFormat": "p99",
                    "refId": "C"
